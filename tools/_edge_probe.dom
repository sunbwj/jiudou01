<!DOCTYPE html>
<html lang="zh-CN" data-theme="blue"><head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<meta name="renderer" content="webkit">
<meta name="format-detection" content="telephone=no">
<title>登录 - 九豆综合管理平台</title>
<link rel="icon" type="image/svg+xml" href="assets/logo.svg">
<link rel="stylesheet" href="css/element-ui.css?v=20261031c">
<link rel="stylesheet" href="css/app.css?v=20261106f">
<link rel="stylesheet" href="css/theme.css?v=20261031c">
</head>
<body class="login-page">

<div class="home-glow"></div>

<div class="login-shell">
    <!-- 左：品牌区（科技感底图由页面背景平铺） -->
    <section class="login-brand">
        <div class="login-brand__top">
            <img class="logo-mark" src="assets/logo.svg" alt="九豆">
            <div>
                <div class="login-brand__name">九豆综合管理平台</div>
                <div class="login-brand__en">JIUDOU MANAGEMENT PLATFORM</div>
            </div>
        </div>
        <h2 class="login-brand__title">一体化管理中枢</h2>
        <!-- 用科技感插图替代原来的文字说明 -->
        <div class="login-brand__art">
            <img src="assets/login-tech.svg" alt="一体化管理中枢示意">
        </div>
        <div class="login-brand__foot">© 2026 九豆综合管理平台 · 数据驱动 · 安全可控</div>
    </section>

    <!-- 右：登录表单 -->
    <section class="login-card">
        <h1 class="login-card__title">用户登录</h1>
        <p class="login-card__sub">请使用员工手机号作为账号登录系统</p>
        <form id="loginForm" autocomplete="off" onsubmit="return false;">
            <div class="login-field">
                <label class="login-field__label" for="loginAccount">登录账号</label>
                <div class="el-input">
                    <span class="login-field__ico">
                        <svg class="svg-ico" viewBox="0 0 24 24" style="width:16px;height:16px"><path fill="currentColor" d="M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"></path></svg>
                    </span>
                    <input class="el-input__inner" type="text" id="loginAccount" maxlength="50" placeholder="请输入账号（默认员工手机号）" autocomplete="username">
                </div>
            </div>
            <div class="login-field">
                <label class="login-field__label" for="loginPassword">登录密码</label>
                <div class="el-input">
                    <span class="login-field__ico">
                        <svg class="svg-ico" viewBox="0 0 24 24" style="width:16px;height:16px"><path fill="currentColor" d="M12 2a5 5 0 00-5 5v3H5v12h14V10h-2V7a5 5 0 00-5-5zm0 2a3 3 0 013 3v3H9V7a3 3 0 013-3z"></path></svg>
                    </span>
                    <input class="el-input__inner" type="password" id="loginPassword" maxlength="32" placeholder="请输入密码" autocomplete="current-password">
                </div>
            </div>
            <!-- 运算表达式验证码：防暴力破解（点击图形可换一题） -->
            <div class="login-field">
                <label class="login-field__label" for="loginCaptcha">验证码</label>
                <div class="login-captcha">
                    <div class="el-input login-captcha__input">
                        <input class="el-input__inner" type="text" id="loginCaptcha" maxlength="4" placeholder="请输入计算结果" autocomplete="off">
                    </div>
                    <button type="button" class="login-captcha__board" id="captchaBoard" title="看不清？点击换一题">
                        <span class="login-captcha__expr" id="captchaExpr">3 × 5 = ?</span>
                        <span class="login-captcha__refresh" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 5V2L8 6l4 4V7a5 5 0 11-5 5H5a7 7 0 107-7z"></path></svg>
                        </span>
                    </button>
                </div>
            </div>
            <div class="login-error" id="loginError"></div>
            <button type="button" class="el-button el-button--primary login-btn" id="btnLogin">登 录</button>
            <!-- 忘记密码：弹窗里输入「员工信息登记的邮箱」→ 服务信箱发 6 位验证码 → 重置密码并回发新密码 -->
            <button type="button" class="login-forgot" id="btnForgot">忘记密码？</button>
            <div class="login-card__foot">登录即表示同意平台使用规范 · 遇到问题请联系系统管理员</div>
        </form>
    </section>
</div>

<!-- ============ 忘记密码弹窗 ============ -->
<div class="login-mask" id="forgotMask" hidden="">
    <div class="login-modal" id="forgotModal" role="dialog" aria-modal="true" aria-labelledby="forgotTitle">
        <div class="login-modal__head">
            <h3 class="login-modal__title" id="forgotTitle">找回密码</h3>
            <button type="button" class="login-modal__close" id="forgotClose" title="关闭" aria-label="关闭">×</button>
        </div>
        <div class="login-modal__body">
            <p class="login-modal__sub">请输入你在「员工信息」里登记的邮箱，系统会通过服务信箱发送 6 位验证码</p>
            <div class="login-field">
                <label class="login-field__label" for="forgotEmail">登记邮箱</label>
                <div class="el-input">
                    <input class="el-input__inner" type="text" id="forgotEmail" maxlength="120" placeholder="例如：name@example.com" autocomplete="off">
                </div>
            </div>
            <div class="login-field">
                <label class="login-field__label" for="forgotCode">验证码</label>
                <div class="forgot-code">
                    <div class="el-input forgot-code__input">
                        <input class="el-input__inner" type="text" id="forgotCode" maxlength="6" placeholder="6 位数字验证码" autocomplete="off">
                    </div>
                    <button type="button" class="el-button el-button--small forgot-code__btn" id="btnSendCode">发送验证码</button>
                </div>
            </div>
            <div class="login-field">
                <label class="login-field__label" for="forgotPwd">新密码</label>
                <div class="el-input">
                    <input class="el-input__inner" type="password" id="forgotPwd" maxlength="32" placeholder="6~32 位，不能是 111111 这种" autocomplete="new-password">
                </div>
            </div>
            <div class="login-field">
                <label class="login-field__label" for="forgotPwd2">确认新密码</label>
                <div class="el-input">
                    <input class="el-input__inner" type="password" id="forgotPwd2" maxlength="32" placeholder="请再输入一次新密码" autocomplete="new-password">
                </div>
            </div>
            <div class="login-error" id="forgotError"></div>
            <button type="button" class="el-button el-button--primary login-btn" id="btnResetPwd">重置密码</button>
            <div class="login-card__foot">重置成功后，新密码会自动发送到你的邮箱，请查收</div>
        </div>
    </div>
</div>

<script src="vendor/jquery-3.7.1.min.js"></script>
<script src="js/theme.js?v=20261031c"></script>
<script src="js/api.js?v=20261106h"></script>
<script src="js/login.js?v=20261105a"></script>


</body></html>
